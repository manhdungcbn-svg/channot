# Copy this file to .env before running: docker compose up --build

# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=secretpassword
POSTGRES_DB=warranty_db

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@warranty.local
PGADMIN_DEFAULT_PASSWORD=admin

# Backend
# Sinh key mới: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=warranty_demo_secret_change_me
AI_MODE=mock
GEMINI_API_KEY=
ALLOW_SANDBOX_TOPUP=true
