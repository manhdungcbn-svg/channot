# ====== BảoHành Pro — Backend environment example ======
# Copy file này thành `.env` và điền giá trị thật.
# TUYỆT ĐỐI KHÔNG commit file `.env` thật (đã có trong .gitignore).
# TUYỆT ĐỐI KHÔNG đặt secret thật vào file này.

# === Database ===
# Mặc định SQLite (dev/test). Khi deploy production, đổi sang PostgreSQL:
#   postgresql+psycopg2://USER:PASSWORD@HOST:5432/warranty
DATABASE_URL=sqlite:///./warranty.db

# === JWT signing key — BẮT BUỘC ===
# Sinh key mới bằng: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Thời gian sống access token (phút). Mặc định 1440 = 24h.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# === CORS ===
# Danh sách origin frontend được phép gọi API (JSON array).
# Mặc định: localhost dev (Vite 5173/5174).
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# === AI Engine ===
# mock | gemini | openai
AI_MODE=mock
# Bắt buộc khi AI_MODE=gemini. Để trống nếu AI_MODE=mock.
GEMINI_API_KEY=

# === Supabase OAuth (bắt buộc nếu dùng nút "Đăng nhập với Google") ===
# Lấy từ Supabase Dashboard → Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional: Google OAuth client ID — verify audience của Google provider_token.
# Nếu rỗng, audience check bị bỏ qua (vẫn verify signature).
SUPABASE_GOOGLE_CLIENT_ID=

# === Wallet / lockout ===
# Số lần login sai tối đa trước khi khóa tài khoản.
MAX_FAILED_LOGIN_ATTEMPTS=5
# Thời gian khóa (phút) sau khi vượt ngưỡng.
LOCKOUT_DURATION_MINUTES=15

# === P0 hardening — Top-up sandbox ===
# TRUE  : cho phép top-up không cần payment_provider_ref (chỉ dùng dev/test).
# FALSE : production — mọi top-up phải kèm `payment_provider_ref` (chứng từ
#         từ cổng thanh toán thật). Chặn user tự khai số tiền.
ALLOW_SANDBOX_TOPUP=true
